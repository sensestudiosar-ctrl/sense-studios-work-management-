# Copy to .env for local development. Never commit the copy.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# API and worker connect as the restricted runtime login. Migrations use a separate administrator URL.
DATABASE_URL=postgresql://sense_app_runtime:replace-with-runtime-password@127.0.0.1:55432/sense_s01_test
MIGRATION_DATABASE_URL=postgresql://sense_s01:replace-with-admin-password@127.0.0.1:55432/sense_s01_test
# Generate a unique high-entropy value for first-Owner enrollment; remove both after enrollment.
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_SECRET=
# Optional Brevo delivery and keyed email verification code hashing. Generate a unique 32+ character secret.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
EMAIL_VERIFICATION_SECRET=
