# Copy to .env.compose for local/staging Compose. Never commit the copy.
S01_DB_USER=sense_s01
S01_DB_NAME=sense_s01_test
S01_DB_PASSWORD=replace-with-a-unique-local-password
S01_DB_PORT=55432
S01_DATABASE_URL=postgresql://sense_s01:replace-with-a-unique-local-password@db:5432/sense_s01_test
S04_APP_DB_PASSWORD=replace-with-a-different-unique-runtime-password
S01_APP_DATABASE_URL=postgresql://sense_app_runtime:replace-with-the-runtime-password@db:5432/sense_s01_test
# Optional one-time S02 Owner enrollment values; remove after enrollment.
S02_OWNER_BOOTSTRAP_EMAIL=
S02_OWNER_BOOTSTRAP_SECRET=
# Optional Brevo transactional email settings. Keep credentials out of source control.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
EMAIL_VERIFICATION_SECRET=
