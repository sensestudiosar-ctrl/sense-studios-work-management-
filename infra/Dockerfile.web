FROM node:24.19.0-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
RUN npm install --global pnpm@11.19.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile
COPY packages/contracts packages/contracts
COPY apps/web apps/web
RUN pnpm --filter @sense/contracts build && pnpm --filter @sense/web build

FROM nginx:1.30.5-alpine3.24 AS base
ARG VCS_REF=development
LABEL org.opencontainers.image.revision=$VCS_REF
COPY infra/nginx-headers.conf /etc/nginx/sense/headers.conf
COPY infra/nginx-proxy.conf /etc/nginx/sense/proxy.conf
COPY infra/nginx-routes.conf /etc/nginx/sense/routes.conf
COPY --from=build /workspace/apps/web/dist /usr/share/nginx/html
EXPOSE 8080

FROM base AS production
LABEL com.sense.web.variant=production
COPY infra/nginx.production.conf /etc/nginx/conf.d/default.conf

# Preserve the existing staging Compose behavior as the default build target.
FROM base AS staging
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
