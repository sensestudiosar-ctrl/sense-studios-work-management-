# Copy OUTSIDE the repository, chmod 600, and replace every placeholder.
# Use literal, single-quoted values. The NAS CLI passes these to Compose without interpolation.
NAS_PROJECT='sense-production'
NAS_ENVIRONMENT='production'
NAS_RELEASE='REPLACE_WITH_VERIFIED_40_CHARACTER_COMMIT'
NAS_WEB_ORIGIN='https://work.YOUR_DOMAIN'
# Obtain tested immutable digests after building the exact accepted release.
NAS_API_IMAGE='ghcr.io/YOUR_ACCOUNT/sense-api@sha256:REPLACE'
NAS_WEB_IMAGE='ghcr.io/YOUR_ACCOUNT/sense-web@sha256:REPLACE'
NAS_POSTGRES_IMAGE='postgres:17.10-alpine3.24@sha256:REPLACE'
NAS_TUNNEL_IMAGE='cloudflare/cloudflared@sha256:REPLACE'
NAS_BACKUP_IMAGE='restic/restic@sha256:REPLACE'
NAS_DB_NAME='sense_production'
NAS_DB_USER='sense_migration'
NAS_DB_PASSWORD='REPLACE_WITH_RANDOM_HEX_SECRET'
NAS_APP_DB_PASSWORD='REPLACE_WITH_DIFFERENT_RANDOM_HEX_SECRET'
NAS_APP_DATABASE_URL='postgresql://sense_app_runtime:REPLACE@db:5432/sense_production'
NAS_MIGRATION_DATABASE_URL='postgresql://sense_migration:REPLACE@db:5432/sense_production'
# Existing, dedicated directories; never set one to a whole NAS volume/root.
NAS_DOCUMENTS_DIR='/REPLACE/sense/documents'
NAS_POSTGRES_DIR='/REPLACE/sense/postgres17'
NAS_BACKUP_DIR='/REPLACE/sense/backups'
NAS_BACKUP_SSH_DIR='/REPLACE/sense/backup-ssh'
NAS_ASSETS_DIR='/REPLACE/sense/previous-assets'
NAS_EXTERNAL_SHARE_SECRET='REPLACE_WITH_RANDOM_HEX_SECRET'
NAS_EMAIL_VERIFICATION_SECRET='REPLACE_WITH_DIFFERENT_RANDOM_HEX_SECRET'
NAS_BREVO_API_KEY='REPLACE_WITH_APPROVED_KEY'
NAS_BREVO_SENDER_EMAIL='REPLACE@YOUR_DOMAIN'
NAS_BREVO_SENDER_NAME='Sense Studios'
NAS_TUNNEL_TOKEN='REPLACE_WITH_APP_ONLY_TUNNEL_TOKEN'
NAS_BACKUP_PASSWORD='REPLACE_WITH_ESCROWED_RANDOM_SECRET'
NAS_OFFSITE_REPOSITORY='sftp:backup@REPLACE_OFFSITE_HOST:/REPLACE_REPOSITORY'
NAS_OFFSITE_CONFIRMED='REPLACE_WITH_yes_AFTER_VERIFYING_A_DIFFERENT_PHYSICAL_LOCATION'
# Initial Owner bootstrap only; remove both after enrollment/recovery setup.
NAS_OWNER_BOOTSTRAP_EMAIL=''
NAS_OWNER_BOOTSTRAP_SECRET=''
