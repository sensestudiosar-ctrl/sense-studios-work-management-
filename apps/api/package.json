{
  "name": "@sense/api",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "files": ["dist", "prisma", "package.json"],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json --noEmit",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand",
    "test:s26": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand src/automation.database.api.spec.ts src/automation-security.database.api.spec.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sense/contracts": "workspace:*",
    "@simplewebauthn/server": "13.3.2",
    "dotenv": "18.0.3",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@jest/test-sequencer": "30.5.2",
    "@nestjs/testing": "12.1.0",
    "@types/express": "5.0.0",
    "@types/jest": "^30.0.0",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "ts-jest": "29.4.10",
    "tsx": "4.23.15"
  }
}
