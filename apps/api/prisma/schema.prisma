generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CrmSource {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(120)
  active         Boolean      @default(true)
  builtIn        Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  leads          Lead[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("crm_sources")
}

model Client {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  name           String          @db.VarChar(160)
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  contacts       ClientContact[]
  leads          Lead[]
  projects       Project[]

  @@unique([id, organizationId])
  @@index([organizationId, name, id])
  @@map("clients")
}

model ClientContact {
  id             String   @id @default(uuid()) @db.Uuid
  clientId       String   @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(160)
  email          String?  @db.VarChar(320)
  phone          String?  @db.VarChar(64)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  client         Client   @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([clientId])
  @@map("client_contacts")
}

model Lead {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  branchId         String            @db.Uuid
  title            String            @db.VarChar(160)
  contactName      String            @db.VarChar(160)
  email            String?           @db.VarChar(320)
  phone            String?           @db.VarChar(64)
  sourceId         String            @db.Uuid
  clientId         String?           @db.Uuid
  priorLostLeadId  String?           @db.Uuid
  stage            LeadStage         @default(NEW)
  version          Int               @default(1)
  createdById      String            @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  outcomeAt        DateTime?         @db.Timestamptz(3)
  lostReason       String?           @db.VarChar(1000)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch           Branch            @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  source           CrmSource         @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  client           Client?           @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  priorLostLead    Lead?             @relation("ReturningLead", fields: [priorLostLeadId, organizationId], references: [id, organizationId], onDelete: Restrict)
  returningLeads   Lead[]            @relation("ReturningLead")
  createdBy        Account           @relation("LeadCreator", fields: [createdById], references: [id], onDelete: Restrict)
  stageChanges     LeadStageChange[]
  activities       LeadActivity[]
  convertedProject Project?          @relation("ProjectWonLead")

  @@unique([id, organizationId])
  @@index([organizationId, branchId, stage, createdAt, id])
  @@index([clientId, branchId])
  @@map("leads")
}

model LeadStageChange {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  leadId         String      @db.Uuid
  fromStage      LeadStage?
  toStage        LeadStage
  direction      String      @db.VarChar(16)
  skippedStages  LeadStage[]
  reason         String?     @db.VarChar(1000)
  actorId        String      @db.Uuid
  occurredAt     DateTime    @default(now()) @db.Timestamptz(3)
  leadVersion    Int
  lead           Lead        @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor          Account     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([leadId, leadVersion])
  @@index([leadId, occurredAt, id])
  @@map("lead_stage_changes")
}

model LeadActivity {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  leadId         String   @db.Uuid
  kind           String   @db.VarChar(64)
  note           String   @db.VarChar(2000)
  actorId        String   @db.Uuid
  occurredAt     DateTime @default(now()) @db.Timestamptz(3)
  lead           Lead     @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor          Account  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([leadId, occurredAt, id])
  @@map("lead_activities")
}

model Project {
  id                     String                @id @default(uuid()) @db.Uuid
  organizationId         String                @db.Uuid
  branchId               String                @db.Uuid
  title                  String                @db.VarChar(160)
  deliveryType           ProjectDeliveryType
  status                 ProjectStatus         @default(DRAFT)
  version                Int                   @default(1)
  clientId               String?               @db.Uuid
  wonLeadId              String?               @db.Uuid
  wonStageChangeId       String?               @db.Uuid
  currentLeadEmployeeId  String?               @db.Uuid
  scopeApproverAccountId String?               @db.Uuid
  createdById            String                @db.Uuid
  createdAt              DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(3)
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch                 Branch                @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  client                 Client?               @relation(fields: [clientId, organizationId], references: [id, organizationId], onDelete: Restrict)
  wonLead                Lead?                 @relation("ProjectWonLead", fields: [wonLeadId, organizationId], references: [id, organizationId], onDelete: Restrict)
  currentLead            Employee?             @relation("CurrentProjectLead", fields: [currentLeadEmployeeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  scopeApprover          Account?              @relation("ProjectScopeApprover", fields: [scopeApproverAccountId], references: [id], onDelete: Restrict)
  createdBy              Account               @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  scopes                 ProjectScope[]
  statusChanges          ProjectStatusChange[]
  assignments            ProjectAssignment[]
  leadChanges            ProjectLeadChange[]
  transfers              ProjectBranchTransfer[]
  scopeChanges           ProjectScopeChange[]
  scopePolicyChanges     ProjectScopePolicyChange[]
  cancellationRequests   ProjectCancellationRequest[]

  @@unique([id, organizationId])
  @@unique([wonLeadId, organizationId])
  @@index([organizationId, branchId, status, createdAt, id])
  @@map("projects")
}

model ProjectScope {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  organizationId String   @db.Uuid
  name           String   @db.VarChar(120)
  normalizedName String   @db.VarChar(120)
  baseline       Boolean  @default(true)
  scopeChangeId  String?  @unique @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  project        Project  @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  scopeChange    ProjectScopeChange? @relation(fields: [scopeChangeId], references: [id], onDelete: Restrict)

  @@unique([projectId, normalizedName])
  @@index([organizationId, projectId])
  @@map("project_scopes")
}

model ProjectStatusChange {
  id             String         @id @default(uuid()) @db.Uuid
  projectId      String         @db.Uuid
  organizationId String         @db.Uuid
  fromStatus     ProjectStatus?
  toStatus       ProjectStatus
  projectVersion Int
  reason         String?        @db.VarChar(1000)
  actorId        String         @db.Uuid
  occurredAt     DateTime       @default(now()) @db.Timestamptz(3)
  project        Project        @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor          Account        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([projectId, projectVersion])
  @@index([projectId, occurredAt, id])
  @@map("project_status_changes")
}

model ProjectAssignment {
  id                    String    @id @default(uuid()) @db.Uuid
  projectId             String    @db.Uuid
  organizationId        String    @db.Uuid
  employeeId            String    @db.Uuid
  crossBranchAuthorized Boolean   @default(false)
  grantedById           String    @db.Uuid
  grantReason           String    @db.VarChar(1000)
  grantedAt             DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt             DateTime? @db.Timestamptz(3)
  revokedById           String?   @db.Uuid
  revocationReason      String?   @db.VarChar(1000)
  project               Project   @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([projectId, revokedAt, employeeId])
  @@index([employeeId, revokedAt])
  @@map("project_assignments")
}

model ProjectLeadChange {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  organizationId String   @db.Uuid
  oldEmployeeId  String?  @db.Uuid
  newEmployeeId  String?  @db.Uuid
  projectVersion Int
  actorId        String   @db.Uuid
  reason         String   @db.VarChar(1000)
  occurredAt     DateTime @default(now()) @db.Timestamptz(3)
  project        Project  @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([projectId, projectVersion])
  @@index([projectId, occurredAt, id])
  @@map("project_lead_changes")
}

model ProjectBranchTransfer {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  organizationId String   @db.Uuid
  fromBranchId   String   @db.Uuid
  toBranchId     String   @db.Uuid
  projectVersion Int
  actorId        String   @db.Uuid
  reason         String   @db.VarChar(1000)
  occurredAt     DateTime @default(now()) @db.Timestamptz(3)
  project        Project  @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([projectId, projectVersion])
  @@index([projectId, occurredAt, id])
  @@map("project_branch_transfers")
}

model ProjectScopeChange {
  id             String    @id @default(uuid()) @db.Uuid
  projectId      String    @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(120)
  normalizedName String    @db.VarChar(120)
  requesterId    String    @db.Uuid
  requestReason  String    @db.VarChar(1000)
  requestedAt    DateTime  @default(now()) @db.Timestamptz(3)
  approvalId     String?   @unique @db.Uuid
  project        Project   @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  approvedScope  ProjectScope?

  @@index([projectId, requestedAt, id])
  @@map("project_scope_changes")
}

model ProjectScopePolicyChange {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @db.Uuid
  organizationId    String   @db.Uuid
  oldApproverId     String?  @db.Uuid
  newApproverId     String   @db.Uuid
  projectVersion    Int
  actorId           String   @db.Uuid
  reason            String   @db.VarChar(1000)
  occurredAt        DateTime @default(now()) @db.Timestamptz(3)
  project           Project  @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([projectId, projectVersion])
  @@map("project_scope_policy_changes")
}

model ProjectCancellationRequest {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  organizationId String   @db.Uuid
  requesterId    String   @db.Uuid
  reason         String   @db.VarChar(1000)
  requestedAt    DateTime @default(now()) @db.Timestamptz(3)
  project        Project  @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([projectId, requestedAt, id])
  @@map("project_cancellation_requests")
}

enum AccountKind {
  OWNER
  STAFF
}

enum AccountState {
  PENDING
  ACTIVE
  SUSPENDED
}

enum WebAuthnChallengePurpose {
  REGISTRATION
  AUTHENTICATION
}

enum EnrollmentGrantPurpose {
  OWNER_BOOTSTRAP
  STAFF_INVITATION
  STAFF_RECOVERY
  OWNER_RECOVERY_SETUP
}

enum SecurityEventType {
  LOGIN
  CREDENTIAL_ADDED
  CREDENTIAL_REVOKED
  SESSION_REVOKED
  RECOVERY_AUTHORIZED
  RECOVERY_USED
  RECOVERY_KIT_ISSUED
  RECOVERY_KIT_ACKNOWLEDGED
  ACCOUNT_STATE_CHANGED
}

enum SecurityEventResult {
  SUCCESS
  FAILURE
}

enum EmployeeState {
  ACTIVE
  SUSPENDED
  EXITED
}

enum PermissionScopeKind {
  ORGANIZATION
  BRANCH
  TEAM
  SELF
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum OrganizationEventType {
  ORGANIZATION_CREATED
  BRANCH_CREATED
  BRANCH_UPDATED
  TEAM_CREATED
  TEAM_UPDATED
  JOB_ROLE_CREATED
  JOB_ROLE_UPDATED
  EMPLOYEE_CREATED
  EMPLOYEE_MEMBERSHIP_CHANGED
  EMPLOYEE_JOB_ROLES_CHANGED
  EMPLOYEE_SUSPENDED
  ROLE_PERMISSION_CHANGED
  EMPLOYEE_PERMISSION_CHANGED
}

enum OutboxDeliveryState {
  PENDING
  LEASED
  DELIVERED
  DEAD
}

enum OutboxConsumer {
  NTF
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryState {
  PENDING
  LEASED
  DELIVERED
  DEAD
}

enum AuditRetentionBackupDisposition {
  CLEARED
  NOT_APPLICABLE
}

enum ApprovalRequestState {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApprovalDecisionOutcome {
  APPROVED
  REJECTED
}

enum LeadStage {
  NEW
  CONTACTED
  MEETING_DISCUSSION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ProjectDeliveryType {
  DESIGN
  TURNKEY
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  CANCELLED
}

model Account {
  id                                String                        @id @default(uuid()) @db.Uuid
  normalizedEmail                   String                        @unique @db.VarChar(320)
  kind                              AccountKind
  state                             AccountState                  @default(PENDING)
  emailVerifiedAt                   DateTime?                     @db.Timestamptz(3)
  createdAt                         DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt                         DateTime                      @updatedAt @db.Timestamptz(3)
  passkeyCredentials                PasskeyCredential[]
  webAuthnChallenges                WebAuthnChallenge[]
  sessions                          Session[]
  enrollmentGrants                  IdentityEnrollmentGrant[]
  recoveryCodes                     OwnerRecoveryCode[]
  recoveryAuthorizations            StaffRecoveryAuthorization[]  @relation("RecoveryTarget")
  authorizationsIssued              StaffRecoveryAuthorization[]  @relation("RecoveryAuthorizer")
  enrollmentGrantsIssued            IdentityEnrollmentGrant[]     @relation("GrantAuthorizer")
  securityEventsAsActor             SecurityEvent[]               @relation("SecurityActor")
  securityEventsAsSubject           SecurityEvent[]               @relation("SecuritySubject")
  employee                          Employee?
  organizationEvents                OrganizationEvent[]           @relation("OrganizationEventActor")
  membershipChanges                 EmployeeMembershipHistory[]   @relation("MembershipChangeActor")
  employeeJobRoleChanges            EmployeeJobRoleAssignment[]   @relation("EmployeeJobRoleActor")
  rolePermissionRevocations         RolePermission[]              @relation("RolePermissionRevoker")
  employeeOverrideRevocations       EmployeePermissionOverride[]  @relation("EmployeePermissionOverrideRevoker")
  auditEventsAsActor                AuditEvent[]                  @relation("AuditEventActor")
  domainEventsAsActor               DomainEvent[]                 @relation("DomainEventActor")
  notifications                     Notification[]
  notificationPreferences           NotificationPreference[]
  notificationQuietHours            NotificationQuietHours?
  emailVerification                 EmailVerificationChallenge?
  auditRetentionConfigs             AuditRetentionConfiguration[]
  auditRetentionNoticesAcknowledged AuditRetentionNotice[]        @relation("RetentionNoticeAcknowledgedBy")
  auditRetentionHoldsPlaced         AuditRetentionHold[]          @relation("RetentionHoldPlacedBy")
  auditRetentionHoldsReleased       AuditRetentionHold[]          @relation("RetentionHoldReleasedBy")
  approvalRequestsCreated           ApprovalRequest[]             @relation("ApprovalRequester")
  approvalRequestsAssigned          ApprovalRequest[]             @relation("ApprovalApprover")
  approvalDelegationsIssued         ApprovalRequest[]             @relation("ApprovalDelegator")
  approvalRequestsDelegated         ApprovalRequest[]             @relation("ApprovalDelegate")
  approvalDecisions                 ApprovalDecision[]            @relation("ApprovalDecider")
  leadsCreated                      Lead[]                        @relation("LeadCreator")
  leadStageChanges                  LeadStageChange[]
  leadActivities                    LeadActivity[]
  projectsCreated                   Project[]                     @relation("ProjectCreator")
  projectsScopeApprover             Project[]                     @relation("ProjectScopeApprover")
  projectStatusChanges              ProjectStatusChange[]

  @@index([state, kind])
  @@map("accounts")
}

model EmailVerificationChallenge {
  accountId           String   @id @db.Uuid
  codeHash            String   @db.Char(64)
  attempts            Int      @default(0)
  sendWindowStartedAt DateTime @db.Timestamptz(3)
  sendsInWindow       Int      @default(1)
  lastSentAt          DateTime @default(now()) @db.Timestamptz(3)
  expiresAt           DateTime @db.Timestamptz(3)
  account             Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([expiresAt])
  @@map("email_verification_challenges")
}

model Organization {
  id                String                       @id @default(uuid()) @db.Uuid
  singletonKey      Int                          @unique @default(1) @db.SmallInt
  name              String                       @db.VarChar(160)
  createdAt         DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @db.Timestamptz(3)
  branches          Branch[]
  teams             Team[]
  jobRoles          JobRole[]
  employees         Employee[]
  rolePermissions   RolePermission[]
  employeeOverrides EmployeePermissionOverride[]
  events            OrganizationEvent[]
  auditEvents       AuditEvent[]
  domainEvents      DomainEvent[]
  approvalRequests  ApprovalRequest[]
  crmSources        CrmSource[]
  clients           Client[]
  leads             Lead[]
  projects          Project[]

  @@map("organizations")
}

model Branch {
  id                String                       @id @default(uuid()) @db.Uuid
  organizationId    String                       @db.Uuid
  name              String                       @db.VarChar(120)
  active            Boolean                      @default(true)
  createdAt         DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @db.Timestamptz(3)
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teams             Team[]
  employees         Employee[]
  history           EmployeeMembershipHistory[]
  rolePermissions   RolePermission[]
  employeeOverrides EmployeePermissionOverride[]
  leads             Lead[]
  projects          Project[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("branches")
}

model Team {
  id                String                       @id @default(uuid()) @db.Uuid
  organizationId    String                       @db.Uuid
  branchId          String                       @db.Uuid
  name              String                       @db.VarChar(120)
  active            Boolean                      @default(true)
  createdAt         DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @db.Timestamptz(3)
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch            Branch                       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  employees         Employee[]
  history           EmployeeMembershipHistory[]
  rolePermissions   RolePermission[]
  employeeOverrides EmployeePermissionOverride[]

  @@unique([branchId, name])
  @@unique([id, branchId, organizationId])
  @@map("teams")
}

model JobRole {
  id             String                      @id @default(uuid()) @db.Uuid
  organizationId String                      @db.Uuid
  name           String                      @db.VarChar(120)
  description    String?                     @db.VarChar(1000)
  active         Boolean                     @default(true)
  createdAt      DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                    @updatedAt @db.Timestamptz(3)
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments    EmployeeJobRoleAssignment[]
  permissions    RolePermission[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@map("job_roles")
}

model Employee {
  id                  String                       @id @default(uuid()) @db.Uuid
  organizationId      String                       @db.Uuid
  accountId           String                       @unique @db.Uuid
  employeeCode        String?                      @db.VarChar(64)
  homeBranchId        String                       @db.Uuid
  homeTeamId          String                       @db.Uuid
  reportsToId         String?                      @db.Uuid
  state               EmployeeState                @default(ACTIVE)
  hiredAt             DateTime                     @db.Date
  suspendedAt         DateTime?                    @db.Timestamptz(3)
  exitedAt            DateTime?                    @db.Timestamptz(3)
  createdAt           DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                     @updatedAt @db.Timestamptz(3)
  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  account             Account                      @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  homeBranch          Branch                       @relation(fields: [homeBranchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  homeTeam            Team                         @relation(fields: [homeTeamId, homeBranchId, organizationId], references: [id, branchId, organizationId], onDelete: Restrict, onUpdate: Cascade)
  reportsTo           Employee?                    @relation("EmployeeReporting", fields: [reportsToId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  directReports       Employee[]                   @relation("EmployeeReporting")
  membershipHistory   EmployeeMembershipHistory[]
  jobRoleAssignments  EmployeeJobRoleAssignment[]
  permissionOverrides EmployeePermissionOverride[]
  projectsLed         Project[]                    @relation("CurrentProjectLead")

  @@unique([organizationId, employeeCode])
  @@unique([id, organizationId])
  @@index([organizationId, homeBranchId, homeTeamId, state])
  @@index([reportsToId, state])
  @@map("employees")
}

model EmployeeMembershipHistory {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @db.Uuid
  organizationId String    @db.Uuid
  branchId       String    @db.Uuid
  teamId         String    @db.Uuid
  reportsToId    String?   @db.Uuid
  effectiveFrom  DateTime  @db.Timestamptz(3)
  effectiveTo    DateTime? @db.Timestamptz(3)
  recordedAt     DateTime  @default(now()) @db.Timestamptz(3)
  recordedById   String    @db.Uuid
  reason         String    @db.VarChar(1000)
  employee       Employee  @relation(fields: [employeeId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  branch         Branch    @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  team           Team      @relation(fields: [teamId, branchId, organizationId], references: [id, branchId, organizationId], onDelete: Restrict, onUpdate: Cascade)
  recordedBy     Account   @relation("MembershipChangeActor", fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([employeeId, effectiveFrom])
  @@index([organizationId, branchId, teamId, effectiveTo])
  @@map("employee_membership_history")
}

model EmployeeJobRoleAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @db.Uuid
  organizationId String    @db.Uuid
  jobRoleId      String    @db.Uuid
  effectiveFrom  DateTime  @db.Timestamptz(3)
  effectiveTo    DateTime? @db.Timestamptz(3)
  recordedAt     DateTime  @default(now()) @db.Timestamptz(3)
  recordedById   String    @db.Uuid
  reason         String    @db.VarChar(1000)
  employee       Employee  @relation(fields: [employeeId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  jobRole        JobRole   @relation(fields: [jobRoleId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  recordedBy     Account   @relation("EmployeeJobRoleActor", fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([employeeId, effectiveFrom])
  @@index([organizationId, jobRoleId, effectiveTo])
  @@map("employee_job_role_assignments")
}

model RolePermission {
