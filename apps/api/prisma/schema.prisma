model AuditEvent {
  id                        String                @id @default(uuid()) @db.Uuid
  organizationId            String                @db.Uuid
  eventKey                  String                @db.VarChar(160)
  schemaVersion             Int                   @default(1)
  occurredAt                DateTime              @default(now()) @db.Timestamptz(3)
  actorId                   String                @db.Uuid
  actorSnapshot             Json
  sessionDeviceRequest      Json?
  subjectType               String                @db.VarChar(100)
  subjectId                 String                @db.VarChar(200)
  reason                    String?               @db.VarChar(1000)
  before                    Json?
  after                     Json?
  correctsEventId           String?               @db.Uuid
  retentionExpiresAt        DateTime              @db.Timestamptz(3)
  correlationId             String                @db.Uuid
  legacyOrganizationEventId String?               @unique @db.Uuid
  organization              Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor                     Account               @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  correctionOf              AuditEvent?           @relation("AuditCorrections", fields: [correctsEventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  corrections               AuditEvent[]          @relation("AuditCorrections")
  legacyOrganizationEvent   OrganizationEvent?    @relation(fields: [legacyOrganizationEventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  retentionNotice           AuditRetentionNotice?
  retentionHolds            AuditRetentionHold[]

  @@index([organizationId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([subjectType, subjectId, occurredAt])
  @@index([eventKey, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([retentionExpiresAt])
  @@map("audit_events")
}

model ApprovalRequest {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @db.Uuid
  typeKey              String               @db.VarChar(120)
  sourceType           String               @db.VarChar(100)
  sourceId             String               @db.VarChar(200)
  sourceGeneration     Int                  @default(1)
  requesterId          String               @db.Uuid
  approverId           String               @db.Uuid
  approvalLevel        String               @db.VarChar(80)
  state                ApprovalRequestState @default(PENDING)
  reason               String               @db.VarChar(1000)
  comment              String?              @db.VarChar(2000)
  context              Json
  evidence             Json?
  requestedAt          DateTime             @default(now()) @db.Timestamptz(3)
  expiresAt            DateTime?            @db.Timestamptz(3)
  resolvedAt           DateTime?            @db.Timestamptz(3)
  delegationAccountId  String?              @db.Uuid
  delegationIssuedById String?              @db.Uuid
  delegationReason     String?              @db.VarChar(1000)
  delegatedAt          DateTime?            @db.Timestamptz(3)
  delegationExpiresAt  DateTime?            @db.Timestamptz(3)
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requester            Account              @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approver             Account              @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  delegationAccount    Account?             @relation("ApprovalDelegate", fields: [delegationAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  delegationIssuedBy   Account?             @relation("ApprovalDelegator", fields: [delegationIssuedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  decision             ApprovalDecision?

  @@unique([organizationId, typeKey, sourceType, sourceId, sourceGeneration])
  @@unique([id, organizationId])
  @@index([organizationId, state, requestedAt, id])
  @@index([approverId, state, requestedAt, id])
  @@index([delegationAccountId, state, requestedAt, id])
  @@map("approval_requests")
}

model ApprovalDecision {
