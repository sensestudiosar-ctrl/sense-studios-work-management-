model Notification {
  id                 String                    @id @default(uuid()) @db.Uuid
  eventId            String                    @db.Uuid
  recipientAccountId String                    @db.Uuid
  channel            NotificationChannel
  category           String                    @db.VarChar(100)
  title              String                    @db.VarChar(180)
  body               String                    @db.VarChar(1000)
  internalRoute      String                    @db.VarChar(500)
  critical           Boolean                   @default(false)
  mandatory          Boolean                   @default(false)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  readAt             DateTime?                 @db.Timestamptz(3)
  deliveryState      NotificationDeliveryState @default(PENDING)
  deliveredAt        DateTime?                 @db.Timestamptz(3)
  attempts           Int                       @default(0)
  failureCode        String?                   @db.VarChar(100)
  event              DomainEvent               @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipient          Account                   @relation(fields: [recipientAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([eventId, recipientAccountId, channel])
  @@index([recipientAccountId, createdAt])
  @@index([eventId])
  @@index([channel, deliveryState, createdAt])
  @@map("notifications")
}

