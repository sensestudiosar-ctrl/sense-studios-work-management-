  leaseExpiresAt DateTime?           @db.Timestamptz(3)
  leaseToken     String?             @db.Uuid
  failureCode    String?             @db.VarChar(100)
  deliveredAt    DateTime?           @db.Timestamptz(3)
  event          DomainEvent         @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)

