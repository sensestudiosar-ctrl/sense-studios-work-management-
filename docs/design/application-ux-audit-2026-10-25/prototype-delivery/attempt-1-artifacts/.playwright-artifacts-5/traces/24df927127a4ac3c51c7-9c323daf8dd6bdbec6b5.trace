e5d8;border-radius:12px;background:#f6f9f4;margin-bottom:14px}\n.create-role-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}\n.create-role-top strong{font-size:14px;color:#234e3b;line-height:1.3}\n.create-role-top p{font-size:11px;line-height:1.6;margin:5px 0 0;color:#6b8070}\n.create-role-label{border-radius:18px;background:#e1ede4;color:#2f634a;padding:7px 9px;font-size:10px;font-weight:800;white-space:nowrap}\n.create-template-row{display:flex;flex-wrap:wrap;gap:7px}\n.create-template-row button{border:1px solid #d6e5d7;background:#fff;color:#476c55;border-radius:8px;font-size:11px;font-weight:700;padding:9px 10px}\n.create-template-row button.active{background:#235741;border-color:#235741;color:#fff}\n.create-guidance{color:#637769;font-size:11px;line-height:1.55}\n.create-guidance.warn{color:#945b2b;background:#fff7e8;border-radius:8px;padding:9px}\n.create-advanced-toggle{border:1px solid #d8e6dc;background:#fff;color:#2c6049;border-radius:9px;padding:10px 12px;text-align:left;font-weight:800;width:100%;font-size:12px}\n.create-advanced-toggle[aria-expanded=\"true\"]{background:#e8f2e9}\n.create-fields .optional-advanced[hidden]{display:none!important}\n.create-form .role-required-caption{grid-column:1/-1;font-size:11px;color:#718474;line-height:1.5}\n.create-task-modal.role-quick .create-section-head{display:none}\n@media(max-width:700px){\n .work-panel{overflow:visible;border-radius:15px}\n .work-panel .panel-head{gap:10px}\n .work-panel .panel-head h2{font-size:17px}\n .work-panel .layoutbar{background:white;gap:7px;padding:11px 13px}\n .mobile-queue-dates{display:flex;gap:7px;overflow-x:auto;scrollbar-width:none;padding:10px 12px 12px;background:#fff;border-top:1px solid #eff1ed;border-bottom:1px solid #e9eee8;scroll-snap-type:x proximity;position:relative}\n .mobile-queue-dates::-webkit-scrollbar{display:none}\n .mobile-queue-dates button{flex-shrink:0;scroll-snap-align:start;display:flex;gap:5px;align-items:center;border:1px solid #e0e8df;background:#f9faf8;border-radius:9px;padding:9px 10px;font-size:11px;color:#4b6453;white-space:nowrap;font-weight:700}\n .mobile-queue-dates button[aria-pressed=\"true\"]{background:#255b46;border-color:#255b46;color:#fff;box-shadow:0 2px 9px #255b4624}\n .mobile-queue-dates button b{border-radius:5px;background:#edf2ed;padding:2px 5px;font-size:10px;color:#4c6857}\n .mobile-queue-dates button[aria-pressed=\"true\"] b{background:#ffffff30;color:#fff}\n .group{border-bottom:0;background:#fafbf9;padding-bottom:4px}\n .group-head{background:#fafbf9;font-size:12px;padding:14px 12px 10px;position:relative;gap:9px}\n .group-head:hover{background:#fafbf9}\n .group .task-row{display:block;min-height:0;margin:0 10px 8px;border:1px solid #e6ebe5;border-left:5px solid var(--state-rail);border-radius:11px;box-shadow:0 1px 3px #294d3910;padding:0;background:#fff!important}\n .group .task-row.selected{background:#fff!important;box-shadow:0 0 0 2px #91b6a1}\n .group .task-row > :not(.mobile-queue-card){display:none!important}\n .group .task-row .mobile-queue-card{display:grid;gap:10px;padding:12px 12px 11px;min-width:0}\n .mobile-queue-card .mq-top{display:flex;align-items:center;justify-content:space-between;gap:8px}\n .mobile-queue-card .mq-type{display:inline-flex;align-items:center;gap:5px;color:#65796a;background:#f3f6f1;padding:5px 7px;border-radius:6px;font-size:10px;font-weight:700}\n .mobile-queue-card .mq-id{font-size:10px;color:#89958b;margin-left:auto}\n .mobile-queue-card .mq-pin{border:0;background:transparent;color:#ad9056;padding:4px;font-size:17px;min-height:27px;min-width:27px}\n .mobile-queue-card .mq-title{font-size:13px;font-weight:760;line-height:1.4;letter-spacing:-.1px;color:#273d30;display:block;word-break:break-word}\n .mobile-queue-card .mq-context{color:#798779;font-size:10px;line-height:1.45;margin-top:4px}\n .mobile-queue-card .mq-labels{display:flex;align-items:center;flex-wrap:wrap;gap:6px}\n .mobile-queue-card .status,.mobile-queue-card .priority-pill{font-size:10px;min-height:25px;display:inline-flex;align-items:center}\n .mobile-queue-card .mq-due{font-size:10px;font-weight:760;color:#5a6b62;padding:5px 7px;background:#edf1ee;border-radius:6px}\n .mobile-queue-card .mq-due.overdue{color:#a62c41;background:#fbe9ea}\n .mobile-queue-card .mq-people{display:flex;align-items:center;gap:7px;color:#5e7264;font-size:11px;line-height:1.3}\n .mobile-queue-card .mq-people .person-avatar{margin:0;width:25px;height:25px}\n .mobile-queue-card .mq-foot{display:flex;align-items:center;justify-content:space-between;gap:8px;border-top:1px solid #eef2ed;padding-top:9px}\n .mobile-queue-card .mq-next{font-size:10px;line-height:1.45;color:#688071;min-width:0;flex:1}\n .mobile-queue-card .mq-next strong{color:#38634d}\n .mobile-queue-card .mq-open{border:1px solid #d4e4d7;background:#f1f7f2;color:#2b694a;padding:8px 10px;border-radius:8px;white-space:nowrap;font-size:10px;font-weight:780;min-height:35px}\n .showmore{background:#fafbf9}\n .modal.create-task-modal{max-height:94dvh;overflow:hidden;display:flex;flex-direction:column;padding:0}\n .modal.create-task-modal h3{margin:0;flex:0 0 auto;background:#fff}\n .modal.create-task-modal #modalBody{overflow-y:auto;min-height:0;flex:1}\n .modal.create-task-modal .modal-actions{margin-top:0;border-top:1px solid #e6ece6;flex:0 0 auto;background:#fff}\n .create-template-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}\n .create-template-row button{white-space:normal;text-align:left}\n .create-role-intro{padding:12px}\n}\n@media(max-width:380px){.mobile-queue-card .mq-foot{align-items:flex-start}.create-role-top{display:block}.create-role-label{display:inline-block;margin-top:7px}}\n\n\n@media(max-width:700px){\n .work-panel .status-legend{display:none!important}\n .mobile-create-fab{display:grid!important;place-items:center;position:fixed;right:17px;bottom:78px;width:52px;height:52px;border-radius:50%;background:#245942;color:white;border:2px solid #fff;box-shadow:0 5px 18px #173e2b50;font-size:28px;font-weight:400;z-index:39;cursor:pointer}\n .work-panel #groups{padding-bottom:64px}\n}\n.mobile-create-fab{display:none}\n"],"\n","\n\n","\n",["DIV",{"id":"task-create-refinement","style":"display: contents;"},["template",{"__playwright_shadow_root_":"open"},["STYLE",{},"\n:host{--ink:#26312b;--muted:#637267;--pine:#244f43;--line:#e3e7de;--cream:#f7f5f0;font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",sans-serif;color:var(--ink)}*{box-sizing:border-box}[hidden]{display:none!important}button,input,select,textarea{font:inherit}button{cursor:pointer;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:9px;padding:10px 16px;min-height:44px;font-size:13px;font-weight:650}button:hover:not(:disabled){background:#edf3ed}button:disabled{opacity:.55;cursor:default}button.primary{background:var(--pine);color:white;border-color:var(--pine)}button.primary:hover:not(:disabled){background:#163d31}button.ghost{background:transparent;border-color:transparent}button.close{padding:7px;width:44px;min-width:44px;font-size:23px;line-height:1}input,select,textarea{width:100%;color:var(--ink);background:#fff;border:1px solid #cdd6c8;border-radius:8px;padding:10px 12px;min-height:44px}textarea{resize:vertical}input[type=checkbox]{width:18px;height:18px;min-height:18px;accent-color:var(--pine)}input:focus-visible,textarea:focus-visible,select:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid #8c6b30;outline-offset:3px}h2,h3,p{margin:0}label{display:block;font-size:12px;font-weight:650}label>input,label>select,label>textarea{margin-top:6px}small,.muted{color:var(--muted);font-size:11px}.optional{font-weight:400;color:var(--muted)}.helper{font-size:11px;line-height:1.5;color:var(--muted);margin-top:6px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}fieldset{border:0;margin:0;padding:0;min-width:0}.eyebrow{font-size:10px;font-weight:750;letter-spacing:1.5px;text-transform:uppercase;color:var(--pine)}.flex{display:flex;align-items:center;gap:10px}.between{justify-content:space-between}.wrap{flex-wrap:wrap}.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}.stack{display:grid;gap:16px}.error{color:#aa2f3d;font-size:11px;font-weight:500;margin-top:5px}.error:empty{display:none}[aria-invalid=true]{border-color:#aa2f3d;box-shadow:0 0 0 1px #aa2f3d}.avatar{width:27px;height:27px;flex:0 0 27px;border-radius:50%;display:grid;place-items:center;background:#e7eee3;color:var(--pine);font-size:10px;font-weight:750}.pill{display:inline-flex;align-items:center;gap:5px;background:#eaf1e6;color:var(--pine);padding:4px 9px;border-radius:5px;font-size:10px;font-weight:650}.req{color:#8c6b30;margin-left:2px}\ndialog{position:fixed;margin:auto;inset:0;padding:0;border:1px solid var(--line);border-radius:16px;width:920px;max-width:calc(100vw - 36px);max-height:92dvh;box-shadow:0 24px 90px #19382f47;color:var(--ink);background:#fff}dialog:not([open]){display:none}dialog::backdrop{background:#19372e66}.frame{display:flex;flex-direction:column;max-height:92dvh}.head{padding:23px 27px 18px;flex:0 0 auto;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:start;gap:12px;background:#fbfbf7}.head h2{font-size:25px;line-height:1.25;letter-spacing:-.6px;margin:5px 0 4px}.head p{font-size:12px;color:var(--muted)}.head-actions{display:flex;align-items:start;gap:3px}.demo-settings{position:relative}.demo-settings summary{list-style:none;cursor:pointer;color:var(--muted);font-size:11px;padding:12px 8px;min-height:44px}.demo-settings summary::-webkit-details-marker{display:none}.settings-body{position:absolute;right:0;top:42px;z-index:3;width:240px;background:white;padding:14px;border:1px solid var(--line);border-radius:9px;box-shadow:0 8px 30px #203b2826}.settings-body p{font-size:11px;margin-top:9px}.body{min-height:0;overflow:auto;overscroll-behavior:contain;padding:24px 27px}.scope-tabs{display:inline-flex;border:1px solid var(--line);background:#f4f6f0;border-radius:9px;padding:3px;gap:3px;margin-bottom:23px}.scope-tabs button{border:0;background:transparent;min-height:38px;font-size:12px;padding:8px 14px;color:var(--muted)}.scope-tabs button[aria-pressed=true]{background:white;box-shadow:0 1px 5px #244f4317;color:var(--pine)}.core{display:grid;grid-template-columns:minmax(0,1fr) 280px;grid-template-areas:'title context' 'brief context' 'reason context' 'extras context';column-gap:28px;row-gap:18px;align-items:start}.title-field{grid-area:title}.brief-field{grid-area:brief}.reason-field{grid-area:reason}.extra-fields{grid-area:extras}.context-fields{grid-area:context;background:#f7f8f3;border:1px solid var(--line);border-radius:11px;padding:17px;display:grid;gap:15px}.title-field input{font-size:21px;font-weight:600;letter-spacing:-.4px;min-height:58px;padding:11px 12px}.brief-field textarea{min-height:108px;line-height:1.6}.context-header{display:flex;align-items:center;justify-content:space-between;padding-bottom:12px;border-bottom:1px solid var(--line)}.context-header strong{font-size:12px}.context-fields .owner-card{display:flex;align-items:center;gap:9px;min-height:46px;padding:8px 10px;margin-top:6px;background:white;border:1px solid #cdd6c8;border-radius:8px;font-size:12px;font-weight:500}.review-note{padding-top:12px;border-top:1px solid var(--line);font-size:11px;line-height:1.6;color:var(--muted)}.extra-fields details{border-top:1px solid var(--line)}.extra-fields details:last-child{border-bottom:1px solid var(--line)}.extra-fields summary{cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:8px;min-height:48px;font-size:12px;font-weight:650;list-style:none;padding:10px 0}.extra-fields summary:after{content:'+';font-size:19px;font-weight:400;color:var(--muted)}.extra-fields details[open] summary:after{content:'−'}.extra-fields .inside{padding:2px 0 18px}.collab-search{margin-bottom:8px;font-size:13px}.person-opt