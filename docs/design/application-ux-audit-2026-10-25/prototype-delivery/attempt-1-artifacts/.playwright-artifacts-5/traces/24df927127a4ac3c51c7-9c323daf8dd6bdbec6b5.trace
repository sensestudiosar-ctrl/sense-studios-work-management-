rs-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\n\n/* Site Employee — action-first shortcuts to existing workflow contexts (prototype only). */\n.site-quick-actions{margin:0 0 17px;padding:16px 17px;background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:0 3px 18px #27493807}\n.site-quick-actions[hidden]{display:none!important}.site-quick-head{display:flex;justify-content:space-between;gap:10px;align-items:start;margin-bottom:12px}.site-quick-head h2{font-size:15px;margin:0 0 5px;letter-spacing:-.2px}.site-quick-head p{font-size:11px;color:var(--muted);margin:0;line-height:1.5}.site-quick-note{border-radius:16px;border:1px solid #dae6df;background:#f0f5f1;color:#466e58;padding:5px 9px;font-size:10px;white-space:nowrap}\n.site-quick-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.site-quick-btn{display:flex;gap:12px;align-items:center;text-align:left;min-height:73px;padding:12px 11px;border:1px solid #e4eae3;background:#fafbf9;border-radius:11px;color:var(--ink)}.site-quick-btn:hover{background:#edf4ee;border-color:#bfd6c8;transform:translateY(-1px)}.site-quick-btn:active{transform:none}.site-quick-btn .quick-icon{display:grid;place-items:center;flex:0 0 38px;height:38px;border-radius:10px;background:#e7f1ea;color:#35654f;font-size:20px}.site-quick-btn .quick-label{display:block;font-size:12px;font-weight:720;line-height:1.3}.site-quick-btn .quick-sub{display:block;font-size:10px;color:#78897c;line-height:1.35;margin-top:4px}.site-quick-btn .quick-count{display:inline-block;background:#f4eade;color:#936c3f;font-weight:700;border-radius:5px;padding:1px 5px;margin-left:4px}\n.site-form{display:grid;gap:12px;max-height:min(54vh,390px);overflow:auto;padding-right:3px}.site-form label{display:grid;gap:6px;color:#576c5e;font-size:11px;font-weight:650}.site-form input,.site-form textarea,.site-form select{width:100%;background:#fff;border:1px solid #dce5dc;border-radius:9px;padding:10px;color:var(--ink);font-size:12px}.site-form textarea{resize:vertical;min-height:72px}.site-note{font-size:11px;color:#687d70;line-height:1.5;padding:9px 11px;border-radius:9px;background:#f3f6f2}.site-preview{padding:10px 12px;border-radius:10px;border:1px solid #dae8dc;background:#f4f9f5;font-size:12px;line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere}\n@media(max-width:980px){.site-quick-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:700px){.site-quick-actions{padding:13px 12px;margin-bottom:12px}.site-quick-grid{gap:8px}.site-quick-btn{min-height:78px;padding:10px 8px;gap:8px}.site-quick-btn .quick-icon{flex-basis:31px;height:32px;font-size:17px}.site-quick-btn .quick-label{font-size:11px}.site-quick-btn .quick-sub{font-size:9px}.site-quick-note{display:none}.site-quick-head{margin-bottom:10px}.site-form{max-height:58vh}}\n\n/* Sense task colour system — Monday-style immediate recognition, unique semantic meaning. */\n:root{--state-todo:#758496;--state-progress:#2384be;--state-review:#e3a52d;--state-waiting:#7d5cb9;--state-correction:#c84955;--state-done:#2b916a;--priority-urgent:#b72f42;--priority-high:#d17623;--priority-normal:#4a76a9;--priority-low:#647d76}\n.status{font-weight:750;letter-spacing:.01em;border-radius:6px;border:1px solid transparent;padding:6px 8px;min-height:27px;font-size:10px;box-shadow:inset 0 -1px 0 #0000000c}\n.status:before{width:6px;height:6px;background:currentColor;opacity:.88}\n.status.todo{background:var(--state-todo);color:#fff}\n.status.progress{background:var(--state-progress);color:#fff}\n.status.review{background:var(--state-review);color:#2e2517}\n.status.waiting{background:var(--state-waiting);color:#fff}\n.status.correction{background:var(--state-correction);color:#fff}\n.status.done{background:var(--state-done);color:#fff}\n.task-status-cell .status{display:flex;justify-content:center;min-height:33px;width:100%;max-width:125px;text-align:center;box-shadow:inset 0 -2px 0 #0000000c}\n.task-row{--state-rail:#758496;--row-tint:#f8f9fb;border-left:5px solid var(--state-rail);padding-left:19px;background:var(--row-tint)}\n.task-row.state-todo{--state-rail:var(--state-todo);--row-tint:#f8f9fb}\n.task-row.state-progress{--state-rail:var(--state-progress);--row-tint:#f4f9fd}\n.task-row.state-review{--state-rail:var(--state-review);--row-tint:#fffbf2}\n.task-row.state-waiting{--state-rail:var(--state-waiting);--row-tint:#f9f6fe}\n.task-row.state-correction{--state-rail:var(--state-correction);--row-tint:#fff6f6}\n.task-row.state-done{--state-rail:var(--state-done);--row-tint:#f5fbf7}\n.task-row:hover{background:#edf5f2;box-shadow:inset 0 0 0 1px #d8e6df}\n.task-row.selected{background:#e6f1ec;box-shadow:inset 0 0 0 2px #9bbdaf;border-left-color:var(--state-rail)}\n.task-row .priorityline{display:none}\n.task-row .task-titleline{display:flex;min-width:0;gap:8px;align-items:center}\n.task-titleline strong{min-width:0;flex:0 1 auto}\n.priority-pill{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;flex:0 0 auto;line-height:1.35;padding:3px 6px;border-radius:4px;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.02em;border:1px solid transparent}\n.priority-pill.pr-Urgent{background:#fbe9ec;color:#ac253a;border-color:#f3cad2}\n.priority-pill.pr-High{background:#fff0dc;color:#a75810;border-color:#f5d8ac}\n.priority-pill.pr-Normal{background:#eaf2fd;color:#365f95;border-color:#d4e4f8}\n.priority-pill.pr-Low{background:#edf2ef;color:#5c766c;border-color:#d8e5dd}\n.cell.due.overdue{display:inline-flex;width:max-content;align-items:center;background:#fce7e8;border:1px solid #f1c6ca;color:#ac3442;border-radius:5px;padding:6px 7px;white-space:nowrap;font-weight:800}\n.mobile-state{display:none;gap:7px;align-items:center;flex-wrap:wrap;margin-top:9px}\n.mobile-due{font-size:10px;color:#596f64;background:#eaf0eb;padding:6px 8px;border-radius:5px;font-weight:750}\n.mobile-due.overdue{background:#fce4e8;color:#af3044;border:1px solid #f1bfc8}\n.pills .status{color:#fff;border-radius:6px}\n.pills .status.review{color:#2e2517}\n.pills .priority-pill{font-size:10px;border-radius:5px}\n.pills .drawer-due.overdue{background:#fce7e8;color:#ae3645;border:1px solid #f1c6ca;font-weight:750}\n.pills .drawer-waiting{background:#f1eafa;color:#674499;font-weight:700}\n.metric{border-left:4px solid #d8e3dd;box-shadow:0 3px 12px #294c3610}\n.metric.metric-action{border-left-color:var(--state-progress);background:linear-gradient(115deg,#f0f8fe,#fff 56%)}\n.metric.metric-overdue,.metric.metric-snags{border-left-color:var(--state-correction);background:linear-gradient(115deg,#fff1f2,#fff 56%)}\n.metric.metric-reviews{border-left-color:var(--state-review);background:linear-gradient(115deg,#fff7e5,#fff 56%)}\n.metric.metric-waiting{border-left-color:var(--state-waiting);background:linear-gradient(115deg,#f5efff,#fff 56%)}\n.metric.metric-uploads{border-left-color:var(--state-waiting);background:linear-gradient(115deg,#f5efff,#fff 56%)}\n.metric-icon{font-size:16px;line-height:1;color:inherit}\n.status-legend{display:flex;align-items:center;gap:11px;flex-wrap:wrap;padding:10px 18px;border-bottom:1px solid #e8eee9;background:#fbfcfb}\n.legend-title{font-weight:800;color:#5a6b60;font-size:11px;white-space:nowrap}\n.legend-scroller{display:flex;align-items:center;gap:5px;flex-wrap:wrap;min-width:0}\n.legend-item{border:1px solid transparent;border-radius:6px;background:transparent;color:#65746b;display:inline-flex;align-items:center;gap:6px;padding:5px 6px;min-height:29px;white-space:nowrap;font-size:10px;font-weight:650}\n.legend-item:hover{background:#eaf1eb;border-color:#d7e4da}\n.legend-item.active{background:#e4f0e8;border-color:#95baa4;color:#244f43;box-shadow:inset 0 0 0 1px #b8d8c4}\n.legend-dot{display:inline-block;width:11px;height:11px;border-radius:3px;background:#758496;flex-shrink:0}\n.legend-dot.todo{background:var(--state-todo)}.legend-dot.progress{background:var(--state-progress)}.legend-dot.review{background:var(--state-review)}.legend-dot.waiting{background:var(--state-waiting)}.legend-dot.correction{background:var(--state-correction)}.legend-dot.done{background:var(--state-done)}\n.legend-hint{margin-left:auto;font-size:10px;color:#98a59b}\n.group-head[data-group=\"Needs My Action\"]{background:#eff7f8;border-left:4px solid var(--state-progress);padding-left:14px}\n.group-head[data-group=\"Pinned\"]{background:#faf7ec;border-left:4px solid var(--gold);padding-left:14px}\n@media(max-width:1100px){.task-status-cell .status{width:100%}}\n@media(max-width:370px){.top-actions{flex-wrap:wrap;justify-content:flex-start}.top-actions .demo-chip{order:3;flex:0 1 auto}.top-actions .role-select{max-width:166px}}\n@media(max-width:700px){\n .task-row{padding:12px 11px 13px 10px;gap:4px;min-height:0;flex-wrap:wrap;align-items:flex-start;border-left-width:5px}\n .task-row .task-name{flex:1 1 100%;gap:7px}\n .task-row .task-name .text{flex:1;min-width:0}\n .task-row .task-titleline{flex-wrap:wrap;gap:5px}\n .task-row .task-titleline strong{font-size:12px}\n .task-row .task-name small{font-size:10px}\n .task-row .cell,.task-row .cell.due.overdue{display:none}\n .task-row .mobile-state{display:flex}\n .task-row .row-action{margin-left:25px;margin-top:4px;align-self:flex-start}\n .task-row .row-action button{background:#fff;border:1px solid #cfdfd4;color:#2f604b;font-size:10px;min-height:30px}\n .status-legend{padding:9px 10px;gap:7px;display:block;overflow:hidden}\n .legend-title{display:block;margin:0 0 6px 2px}\n .legend-scroller{overflow-x:auto;flex-wrap:nowrap;scrollbar-width:thin;padding-bottom:4px}\n .legend-hint{display:none}\n .metric{border-left-width:4px}\n}\n\n/* Flat task list: keep semantic status rails and vivid badges, remove all row colour washes. */\n.task-row,.task-row.state-todo,.task-row.state-progress,.task-row.state-review,.task-row.state-waiting,.task-row.state-correction,.task-row.state-done{background:#fff;--row-tint:#fff}\n.task-row:hover{background:#fff;box-shadow:inset 0 0 0 1px #d0dad2}\n.task-row.selected{background:#fff;box-shadow:inset 0 0 0 2px #8aab9b}\n.task-name .task-titleline .priority-pill{display:none}\n.priority-cell{display:flex;justify-content:flex-start;align-items:center}\n.priority-cell .priority-pill{min-width:68px;min-height:29px;padding:6px 9px;font-size:10px;font-weight:800}\n.panel-head-actions{display:flex;align-items:center;gap:8px;flex-shrink:0}\n.panel-head-actions #createTaskBtn{box-shadow:0 2px 8px #244f4324}\n/* Accessible task-creation form, visually separate from the work list. */\n.modal.create-task-modal{width:min(740px,calc(100vw - 24px));max-height:min(90vh,880px);display:none;flex-direction:column;padding:0;overflow:hidden}\n.modal.create-task-modal.open{display:flex}\n.modal.create-task-modal h3{margin:0;padding:20px 22px 13px;border-bottom:1px solid var(--line);font-size:18px}\n.modal.create-task-modal #modalBody{overflow:auto;padding:14px 22px 12px;min-height:0}\n.modal.create-task-modal .modal-actions{padding:13px 22px 18px;margin:0;border-top:1px solid var(--line);background:#fff}\n.create-form{display:grid;gap:13px}\n.create-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 15px}\n.create-form label{display:flex;flex-direction:column;gap:6px;font-size:11px;font-weight:750;color:#496252;min-width:0}\n.create-form input,.create-form select,.create-form textarea{width:100%;min-height:37px;padding:9px 10px;border:1px solid #d7e2d8;border-radius:8px;background:#fff;color:var(--ink);font-size:12px}\n.create-form textarea{resize:vertical;min-height:65px}\n.create-form input[type=file]{padding:9px 6px;min-height:42px}\n.create-form .span-2{grid-column:1/-1}\n.create-hint{color:#708176;font-size:10px;line-height:1.5;font-weight:500}\n.create-required{color:#bd4b4b}\n.create-section-head{font-size:12px;font-weight:800;color:#244f43;border-top:1px solid #e6ede7;padding-top:13px;margin-top:1px}\n.create-demo-disclaimer{font-size:11px;color:#745e32;background:#faf4e8;border:1px solid #edddb9;padding:10px 12px;border-radius:9px;line-height:1.6}\n.create-error{border-radius:8px;border:1px solid #e5aaaa;background:#fff5f4;color:#9d3030;padding:10px;font-size:11px}\n@media(max-width:1100px) and (min-width:701px){.task-row,.tablehead{gap:9px}}\n@media(max-width:700px){\n .panel-head{align-items:flex-start;flex-wrap:wrap}\n .panel-head-actions{margin-left:auto;gap:6px}\n .panel-head-actions #createTaskBtn{font-size:11px;padding:7px 10px;min-height:34px}\n .panel-head-actions #viewSettings{font-size:10px;padding:6px 8px;min-height:34px}\n .task-name .task-titleline .priority-pill{display:inline-flex}\n .task-row .priority-cell{display:none}\n .modal.create-task-modal{top:auto;bottom:0;max-height:94dvh;width:100%;border-radius:18px 18px 0 0;transform:translateX(-50%)}\n .modal.create-task-modal h3{padding:16px 15px 12px}\n .modal.create-task-modal #modalBody{padding:12px 15px}\n .modal.create-task-modal .modal-actions{padding:12px 15px 16px;justify-content:stretch}\n .modal.create-task-modal .modal-actions button{flex:1}\n .create-fields{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}\n}\n@media(max-width:370px){.create-fields{grid-template-columns:1fr}.create-form .span-2{grid-column:auto}}\n\n/* Owner refinement: People column shows the worker, collaborators and assigning actor separately. */\n.tablehead,.task-row{grid-template-columns:minmax(215px,2.25fr) minmax(105px,.95fr) minmax(156px,1.25fr) 70px 108px 78px minmax(98px,.9fr);column-gap:10px}\n.people-cell{min-width:0;overflow:visible;white-space:normal}\n.people-trigger{display:flex;align-items:center;gap:7px;border:1px solid transparent;background:#fff;border-radius:8px;padding:4px 5px;width:100%;max-width:100%;text-align:left;color:var(--ink);min-height:44px}\n.people-trigger:hover,.people-trigger:focus-visible{background:#f5f7f5;border-color:#dce8df}\n.avatar-stack{display:inline-flex;align-items:center;flex-shrink:0;min-width:29px;padding-left:4px}\n.person-avatar{width:27px;height:27px;display:inline-grid;place-items:center;margin-left:-5px;border:2px solid #fff;border-radius:50%;background:#d5e9e3;color:#215642;font-weight:800;font-size:9px;letter-spacing:-.3px;flex-shrink:0}\n.person-avatar:nth-child(2){background:#e7def2;color:#63468a}.person-avatar:nth-child(3){background:#f6e6c9;color:#78541f}\n.person-plus{height:25px;min-width:25px;border-radius:50%;display:grid;place-items:center;margin-left:-5px;background:#e9ebef;color:#536270;font-size:9px;font-weight:800;border:2px solid #fff}\n.people-copy{min-width:0;display:grid;gap:3px;line-height:1.15}.people-copy strong{display:block;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:750}.people-copy small{display:block;font-size:10px;color:#839086;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.mobile-people{display:none;font-size:10px;color:#586e62;margin-top:7px;align-items:center;gap:6px;line-height:1.4;flex-wrap:wrap}\n.mobile-people .person-avatar{width:22px;height:22px;font-size:8px;margin:0}\n.team-people-filter{display:none;align-items:center;gap:5px;color:#517161;font-weight:650;white-space:nowrap}\n.team-people-filter.visible{display:inline-flex}.team-people-filter select{max-width:135px;font-size:11px}\n.people-info-card{display:grid;gap:12px}.people-info-row{display:flex;gap:10px;align-items:flex-start;padding:10px 11px;border:1px solid #e8ede8;border-radius:9px;background:#fff}\n.people-info-row .person-avatar{width:32px;height:32px;font-size:10px;margin:0}\n.people-info-row .people-info-text{display:grid;gap:4px}.people-info-row b{font-size:12px}.people-info-row small{font-size:10px;color:#77877c}\n.people-section-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}\n.people-section-grid .entry{min-width:0}.people-section-grid .entry b{overflow-wrap:anywhere}\n@media(max-width:1320px) and (min-width:901px){.tablehead,.task-row{grid-template-columns:minmax(185px,2fr) minmax(158px,1.18fr) 70px 108px 80px minmax(100px,.8fr);gap:8px}.tablehead>div:nth-child(2),.task-row>.project-cell{display:none}}\n@media(max-width:900px) and (min-width:701px){.tablehead,.task-row{grid-template-columns:minmax(150px,2fr) minmax(140px,1.25fr) 96px 76px;gap:7px}.tablehead>div:nth-child(2),.task-row>.project-cell,.tablehead>div:nth-child(4),.task-row>.cell.due,.tablehead>div:nth-child(7),.task-row>.row-action{display:none}.people-copy small{font-size:9px}.task-status-cell .status{font-size:9px}}\n@media(max-width:700px){.task-row .people-cell{display:none}.task-row .mobile-people{display:flex}.people-section-grid{grid-template-columns:1fr}.team-people-filter select{max-width:105px}.layoutbar{flex-wrap:wrap;row-gap:5px}}\n<style>\n.create-collabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin-top:6px}\n.create-form label.collab-option{font-size:11px;display:flex;flex-direction:row;align-items:center;gap:7px;border:1px solid #e0e9df;border-radius:7px;padding:8px;color:#375447;font-weight:600}\n.create-form label.collab-option input{width:16px;height:16px;min-height:16px;flex-shrink:0}\n.collab-option small{font-weight:400;color:#859188}\n@media(max-width:700px){.create-collabs{grid-template-columns:repeat(2,minmax(0,1fr))}}\n\n/* Summary KPI drill-down: one click opens precisely the matching task records. */\n.metric.metric-button{font:inherit;color:inherit;text-align:left;width:100%;cursor:pointer;position:relative;transition:border-color .12s,box-shadow .12s,transform .12s}\n.metric.metric-button:hover{border-color:#aac3b2;box-shadow:0 6px 18px #214c3d21;transform:translateY(-1px)}\n.metric.metric-button:focus-visible{outline:3px solid #78a98d;outline-offset:3px}\n.metric.metric-button[aria-pressed=\"true\"]{border-color:#346e57;box-shadow:0 0 0 2px #9ac8af,0 6px 18px #214c3d18}\n.metric.metric-button .metric-bottom{display:flex;align-items:center;justify-content:space-between;gap:5px;width:100%;font-size:10px;color:#758b7e}\n.metric.metric-button .metric-arrow{font-size:15px;color:#567967;line-height:1;flex-shrink:0}\n.metric.metric-button[aria-pressed=\"true\"] .metric-bottom{color:#235e47;font-weight:750}\n.metric-focus{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 18px;background:#f0f7f1;border-bottom:1px solid #d3e2d7;scroll-margin-top:16px}\n.metric-focus[hidden]{display:none!important}\n.metric-focus-copy{display:flex;align-items:flex-start;gap:10px;min-width:0}\n.metric-focus-symbol{display:grid;place-items:center;width:30px;height:30px;border-radius:8px;color:#246447;background:#dfeee4;flex-shrink:0}\n.metric-focus strong{display:block;color:#23533d;font-size:12px}\n.metric-focus .focus-subtitle{display:block;color:#72877a;font-size:10px;margin-top:4px;line-height:1.3}\n.metric-focus .button{flex-shrink:0;min-height:34px}\n@media(max-width:700px){\n .summary{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}\n .summary .metric:last-child{display:flex}\n .metric.metric-button{min-height:92px;padding:12px}\n .metric.metric-button .metric-bottom{font-size:10px}\n .metric-focus{padding:12px;align-items:flex-start;flex-wrap:wrap}\n .metric-focus .button{margin-left:40px}\n}\n\n/* Completion pass — functional My Work UX, demo-only interactions */\n.notification-count{display:inline-grid;place-items:center;min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:#c95754;color:#fff;font-weight:800;font-size:10px}\n.network-banner{border:1px solid #e9b99c;background:#fff6ee;color:#80502d;border-radius:11px;padding:11px 15px;margin:-6px 0 14px;font-size:12px;line-height:1.5}\n.network-banner[hidden],.timer-banner[hidden],.team-workload[hidden]{display:none!important}\n.timer-banner{display:flex;align-items:center;justify-content:space-between;gap:10px;background:#eaf3ed;border:1px solid #cddfd1;color:#2c6448;border-radius:11px;padding:10px 14px;margin-bottom:14px;flex-wrap:wrap}\n.timer-banner strong{font-size:12px}.timer-banner span{font-size:11px}.timer-banner .elapsed{font-size:16px;font-weight:800;font-variant-numeric:tabular-nums}\n.team-workload{border:1px solid #e3e9e2;border-radius:14px;background:#fff;margin:0 0 16px;padding:15px 16px}\n.workload-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.workload-heading h2{margin:0;font-size:15px}.workload-heading p{margin:4px 0 0;font-size:11px;color:#839087}\n.workload-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}\n.workload-person{display:grid;gap:6px;text-align:left;background:#fff;border:1px solid #e4e9e2;border-radius:10px;padding:12px;min-width:0}\n.workload-person:hover{border-color:#91b5a1;box-shadow:0 4px 12px #244f430a}\n.workload-person.active{border-color:#326754;box-shadow:0 0 0 2px #b8d8c3}\n.workload-person .person-title{display:flex;gap:7px;align-items:center;min-width:0}.workload-person .person-title b{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.workload-person .load-stats{font-size:11px;color:#5b7061}.workload-person .load-stats em{font-style:normal;color:#b74f48;font-weight:800}.workload-person .load-track{height:6px;border-radius:8px;background:#e9efea;overflow:hidden}.workload-person .load-track i{height:100%;background:#41886a;display:block;border-radius:8px}\n.workload-caption{font-size:10px;color:#87948a;margin-top:10px}\n.enhanced-section{border-top:1px solid #e7eee7;margin-top:16px;padding-top:15px}\n.detail-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.detail-tag{background:#eef3ef;border:1px solid #dce6dd;border-radius:5px;color:#416653;padding:5px 7px;font-size:10px}\n.review-actions{margin-top:10px;display:flex;gap:7px;flex-wrap:wrap}.review-actions .button{white-space:normal}\n.link-action{color:#275e47;background:transparent;border:0;padding:3px 0;text-align:left;text-decoration:underline;text-underline-offset:2px;font-size:12px}\n.mini-hint{font-size:11px;color:#819084;line-height:1.5}.small-count{font-weight:700;font-size:12px}.muted-list{display:grid;gap:6px}.muted-list .mini-item{padding:8px;border:1px solid #edf0eb;border-radius:7px;font-size:11px}\n.review-workspace{display:grid;gap:13px}.review-preview{position:relative;min-height:185px;border:1px solid #cadad0;border-radius:11px;background:linear-gradient(145deg,#f8faf8,#e9efe9);overflow:hidden;cursor:crosshair;touch-action:manipulation}\n.review-preview:before{content:'';display:block;position:absolute;inset:18px 28px;background:linear-gradient(90deg,transparent 49%,#baccc2 49%,#baccc2 50%,transparent 50%),linear-gradient(transparent 49%,#baccc2 49%,#baccc2 50%,transparent 50%);background-size:68px 68px;opacity:.4}\n.review-preview .drawing-label{position:absolute;left:12px;top:10px;background:#fff;border:1px solid #dde5de;border-radius:6px;padding:5px 8px;color:#527260;font-size:10px;font-weight:700}\n.annotation-pin{position:absolute;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;background:#c24d4a;color:#fff;font-weight:800;font-size:11px;border:2px solid #fff;box-shadow:0 2px 7px #3333;transform:translate(-50%,-50%)}\n.annotation-rectangle{position:absolute;border:2px solid #c24d4a;background:#c24d4a20;min-width:45px;min-height:30px;pointer-events:none}\n.review-options{display:flex;gap:7px;flex-wrap:wrap}.review-options button[aria-pressed=true]{background:#e5f2e7;border-color:#56896a;color:#2e6349}\n.review-workspace textarea,.review-workspace input,.review-workspace select,.site-form input[type=file],.site-form input[type=date]{width:100%;border:1px solid #dce4de;border-radius:8px;background:#fff;padding:9px;font:inherit;font-size:12px;min-height:38px}\n.review-workspace textarea{min-height:75px;resize:vertical}\n.review-history{display:grid;gap:7px;margin-top:7px}.review-history>div{font-size:11px;border-left:3px solid #aac6b1;padding:7px 10px;background:#f7faf7}\n.milestone-line{display:flex;align-items:center;gap:5px;flex-wrap:wrap;font-size:11px;color:#607566;margin-top:7px}\n.subtask-row{display:flex;gap:9px;align-items:center;padding:7px 0;font-size:12px;border-bottom:1px solid #eef1ed}.subtask-row input{width:16px;height:16px}\n.time-entry{display:flex;align-items:center;justify-content:space-between;gap:10px;border:1px solid #e6ebe6;border-radius:8px;padding:9px 10px;margin-bottom:6px;font-size:11px}\n.notification-row{display:flex;align-items:flex-start;gap:10px;width:100%;padding:12px 8px;text-align:left;border:0;border-bottom:1px solid #e9eee9;background:#fff;color:var(--ink)}.notification-row:hover{background:#f5faf6}.notification-row strong{display:block;font-size:12px}.notification-row small{display:block;color:#778579;margin-top:4px;font-size:11px}.notification-dot{width:8px;height:8px;background:#c65a4f;border-radius:50%;flex-shrink:0;margin-top:5px}\n.demo-state-actions{display:flex;gap:7px;flex-wrap:wrap}.demo-state-actions .button{font-size:11px}\n.create-form select[multiple]{height:auto;min-height:94px}\ninput[type=checkbox]{accent-color:#326754}\n@media(max-width:1100px){.workload-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.top-actions{flex-wrap:wrap}}\n@media(max-width:700px){.workload-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.team-workload{padding:12px}.workload-person{padding:9px}.notif-trigger{font-size:11px;padding:7px 9px}.timer-banner{padding:9px}.review-preview{min-height:200px}.review-actions .button{flex:1}}\n@media(max-width:370px){.workload-grid{grid-template-columns:1fr}.notif-trigger{font-size:10px}}\n@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}\n\n.compare-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:10px 0}.compare-two[hidden]{display:none}.compare-version{border:1px solid #d2e0d6;border-radius:10px;padding:14px;background:#fafcfb;min-height:120px;display:grid;gap:8px}.compare-version b{font-size:12px;color:#365847}.compare-version span{font-size:11px;word-break:break-all}.compare-version p{font-size:11px;color:#76867a;margin:0}\n@media(max-width:420px){.compare-two{grid-template-columns:1fr}}\n"],"\n",["STYLE",{},"\n/* Owner-only organization dashboard. All data in this prototype is sample task data. */\n.owner-dashboard{display:none;min-width:0;--dash-radius:13px}\nbody.owner-dashboard-mode .owner-dashboard{display:block}\nbody.owner-dashboard-mode .title-row,body.owner-dashboard-mode #summary,body.owner-dashboard-mode #teamWorkload,body.owner-dashboard-mode #siteQuickActions,body.owner-dashboard-mode #workPanel,body.owner-dashboard-mode .footer-note{display:none!important}\nbody.owner-dashboard-mode #networkBanner,body.owner-dashboard-mode #activeTimerBar{display:none!important}\n.owner-dashboard .od-head{display:flex;justify-content:space-between;align-items:flex-start;gap:18px;margin-bottom:20px}\n.owner-dashboard .od-head h1{font-size:29px;line-height:1.12;letter-spacing:-.8px;margin:5px 0 8px}\n.owner-dashboard .od-controls{display:flex;gap:9px;align-items:center;flex-wrap:wrap}\n.owner-dashboard .od-controls label{font-size:11px;color:#687b6e;font-weight:650}\n.owner-dashboard select{min-height:36px;padding:7px 9px;border-radius:9px;border:1px solid #d7e3d8;max-width:180px}\n.owner-dashboard .od-note{font-size:11px;line-height:1.6;color:#786b4b;background:#faf5e7;border:1px solid #e9ddbf;border-radius:9px;padding:10px 12px;margin:0 0 17px}\n.owner-dashboard .od-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:17px}\n.owner-dashboard .od-metric{background:#fff;border:1px solid #e3eae1;border-radius:12px;padding:14px;text-align:left;display:grid;gap:7px;min-width:0;color:inherit}\n.owner-dashboard button.od-metric{cursor:pointer}\n.owner-dashboard button.od-metric:hover,.owner-dashboard .od-team:hover,.owner-dashboard .od-worker:hover,.owner-dashboard .od-project-row:hover{outline:2px solid #b1d1bc;outline-offset:-2px}\n.owner-dashboard .od-metric strong{font-size:27px;font-weight:800;letter-spacing:-.7px}\n.owner-dashboard .od-metric .od-label{font-size:11px;font-weight:730;color:#627467;display:flex;gap:7px;align-items:center}\n.owner-dashboard .od-metric small{font-size:10px;color:#839187}\n.owner-dashboard .od-card{background:#fff;border:1px solid #e3e9e0;border-radius:14px;padding:16px;min-width:0;margin-bottom:16px}\n.owner-dashboard .od-card-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:14px}\n.owner-dashboard h2{margin:0;font-size:15px;letter-spacing:-.25px}\n.owner-dashboard .od-card-head small,.owner-dashboard .od-muted{font-size:10px;color:#809086}\n.owner-dashboard .od-card-btn{border:0;color:#386e53;background:transparent;font-size:11px;font-weight:700;padding:7px;border-radius:7px}\n.owner-dashboard .od-card-btn:hover{background:#f0f6f0}\n.owner-dashboard .od-twocol{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(285px,1fr);gap:16px}\n.owner-dashboard .od-team-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}\n.owner-dashboard .od-team{display:grid;gap:10px;text-align:left;background:#fff;border:1px solid #e5ebe5;border-radius:11px;padding:13px;color:inherit;min-width:0}\n.owner-dashboard .od-team-title{display:flex;align-items:center;justify-content:space-between;font-weight:800;font-size:12px;gap:6px}\n.owner-dashboard .od-team-title .od-team-icon{font-size:11px;border-radius:7px;padding:5px 6px;background:#edf3ef;color:#416755;flex-shrink:0}\n.owner-dashboard .od-team-stats{display:grid;grid-template-columns:1fr 1fr;gap:7px;color:#7d8b80;font-size:10px}\n.owner-dashboard .od-team-stats b{display:block;color:#324b3b;font-size:18px;margin-bottom:2px}\n.owner-dashboard .od-stack{height:8px;background:#eef0ed;border-radius:5px;display:flex;overflow:hidden;gap:1px}\n.owner-dashboard .od-stack span{height:100%}\n.owner-dashboard .od-foot{color:#849187;font-size:10px;line-height:1.55}\n.owner-dashboard .od-mini-bars{display:grid;gap:10px}\n.owner-dashboard .od-mini-line{display:grid;grid-template-columns:95px 1fr 45px;align-items:center;gap:7px;font-size:11px;color:#67776b}\n.owner-dashboard .od-mini-line .od-track{height:8px;background:#edf1ec;border-radius:5px;overflow:hidden}\n.owner-dashboard .od-mini-line .od-track i{display:block;height:100%;background:#507e64;border-radius:5px}\n.owner-dashboard .od-risk-list{display:grid;gap:8px}\n.owner-dashboard .od-risk-item{width:100%;text-align:left;border:1px solid #e7ece5;background:#fff;border-radius:9px;padding:10px 12px;display:flex;justify-content:space-between;gap:10px;align-items:center;color:#3f5145}\n.owner-dashboard .od-risk-item:hover{background:#f8fbf8}\n.owner-dashboard .od-risk-item strong{font-size:11px;display:block}\n.owner-dashboard .od-risk-item small{font-size:10px;color:#7d8e82;display:block;margin-top:4px}\n.owner-dashboard .od-pill{display:inline-block;font-size:10px;font-weight:750;padding:5px 8px;border-radius:7px;color:#975b35;background:#fff0de;white-space:nowrap}\n.owner-dashboard .od-workers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}\n.owner-dashboard .od-worker{background:#fff;border:1px solid #e5ebe5;border-radius:10px;display:grid;gap:9px;text-align:left;color:#3b5444;padding:11px;min-width:0}\n.owner-dashboard .od-person{display:flex;align-items:center;gap:9px}\n.owner-dashboard .od-person .person-avatar{width:30px;height:30px;font-size:10px;margin:0}\n.owner-dashboard .od-person strong{display:block;font-size:12px}\n.owner-dashboard .od-person small{display:block;font-size:10px;color:#8b988e;margin-top:2px}\n.owner-dashboard .od-worker-metrics{display:flex;flex-wrap:wrap;gap:6px;font-size:10px;color:#6e7c72}\n.owner-dashboard .od-worker-metrics span{padding:5px 7px;border-radius:7px;background:#f4f6f2}\n.owner-dashboard .od-worker-metrics .warn{background:#fff0ea;color:#aa5d40}\n.owner-dashboard .od-projects{display:grid;gap:8px}\n.owner-dashboard .od-project-ro