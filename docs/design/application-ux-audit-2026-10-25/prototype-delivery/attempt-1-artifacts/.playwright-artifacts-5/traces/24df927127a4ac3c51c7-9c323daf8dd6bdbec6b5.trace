margin-top:2px}\n .mobile-queue-card .mq-labels{gap:5px}\n .mobile-queue-card .mq-due{order:0}\n .mobile-queue-card .status{order:1}\n .mobile-queue-card .priority-pill{order:2}\n .mobile-queue-card .mq-people{font-size:10px}\n .mobile-queue-card .mq-people .person-avatar{width:22px;height:22px}\n .mobile-queue-card .mq-foot{padding-top:7px}\n .mobile-queue-card .mq-open{min-height:40px;padding:7px 9px}\n .team-workload{margin-top:10px}\n .team-workload .workload-heading{gap:8px}\n .team-workload .workload-heading h2{font-size:13px}\n .team-workload .workload-caption-short{font-size:10px}\n .workload-toggle{min-height:34px}\n .create-secondary-panel{grid-column:1/-1}\n .create-secondary-grid{grid-template-columns:1fr 1fr}\n .create-step-label{font-size:10px}\n}\n@media(max-width:380px){.mobile-queue-card .mq-people{line-height:1.2}.create-secondary-grid{grid-template-columns:1fr}}\n/* Progressive task form: only the first essential group is shown initially for staff. */\n.create-step-label{grid-column:1/-1;background:#f0f5f0;border-radius:8px;padding:9px 11px;font-size:11px;font-weight:850;color:#365f48}\n.create-secondary-panel{grid-column:1/-1;border:1px solid #dfe9df;border-radius:10px;padding:10px;display:grid;gap:9px;background:#fbfdfb}\n.create-secondary-toggle{border:1px solid #cddfd2;background:#edf5ef;color:#2b6248;border-radius:9px;min-height:40px;text-align:left;font-size:12px;font-weight:800;padding:9px 12px}\n.create-secondary-toggle[aria-expanded=\"true\"]{background:#e6f1e8}\n.create-secondary-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 15px}\n.create-secondary-grid[hidden]{display:none!important}\n.create-secondary-grid .span-2{grid-column:1/-1}\n"],"\n",["STYLE",{},"\n:root{--cx-paper:#fffdf7;--cx-line:#d9d8cd;--cx-muted:#50645a;--cx-pine:#29463d}\n[hidden]{display:none!important} .cx-skip{position:fixed;top:-100px;left:12px;z-index:2000;background:white;padding:14px;color:#182c29}.cx-skip:focus{top:10px}\n.cx-harness{background:#e3eadf;color:#20332e;padding:8px 18px;display:flex;gap:12px;align-items:center;flex-wrap:wrap;font:12px/1.5 Inter,system-ui,sans-serif;border-bottom:1px solid #bbc8bc}.cx-harness summary{cursor:pointer;min-height:32px;display:flex;align-items:center}.cx-harness label{display:inline-flex;gap:8px;align-items:center;margin:6px 12px 6px 0}.cx-harness select{min-height:44px;max-width:190px}.cx-harness p{max-width:850px;margin:5px 0}.cx-harness details{margin-left:auto}.cx-harness details[open]{flex-basis:100%}\n.cx-page{padding:18px 0 70px}.cx-heading{display:flex;gap:16px;justify-content:space-between;align-items:start;margin:4px 0 22px}.cx-heading h1{font-size:30px;letter-spacing:-.8px;margin:4px 0 8px;color:#182c29}.cx-heading p,.cx-muted{color:var(--cx-muted);line-height:1.55}.cx-eyebrow{font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:var(--cx-muted);font-weight:700}.cx-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.cx-btn{font:600 13px/1.4 Inter,system-ui,sans-serif;min-height:44px;border:1px solid #b8c4b9;background:var(--cx-paper);border-radius:8px;padding:10px 14px;color:#20332e;cursor:pointer}.cx-btn:hover{background:#e3eadf}.cx-btn.primary{background:#29463d;color:white;border-color:#29463d}.cx-btn:disabled{opacity:.6;cursor:default}.cx-link{border:0;background:transparent;text-align:left;color:#244f43;font:600 13px/1.5 Inter,system-ui,sans-serif;cursor:pointer;min-height:44px;padding:6px 0;text-decoration:underline;text-underline-offset:3px}.cx-pill{display:inline-block;font:600 11px/1.5 Inter,system-ui,sans-serif;padding:5px 9px;border-radius:20px;background:#e3eadf;color:#29463d}.cx-pill.warn{background:#faecd6;color:#744317}\n.cx-stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-bottom:18px}.cx-stat{background:var(--cx-paper);border:1px solid var(--cx-line);border-radius:13px;padding:17px;text-align:left;color:#20332e;cursor:pointer;min-height:130px;display:flex;flex-direction:column;justify-content:space-between}.cx-stat span{font-size:12px;font-weight:650}.cx-stat strong{font-size:32px;letter-spacing:-1px}.cx-stat small{font-size:11px;color:var(--cx-muted)}\n.cx-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,1fr);gap:16px;align-items:start}.cx-card{background:var(--cx-paper);border:1px solid var(--cx-line);border-radius:13px;overflow:hidden;margin-bottom:16px;min-width:0}.cx-card>header{padding:17px 19px;border-bottom:1px solid var(--cx-line);display:flex;align-items:center;justify-content:space-between;gap:12px}.cx-card h2{font-size:16px;margin:0;color:#182c29}.cx-card header p{font-size:12px;margin:4px 0 0;color:var(--cx-muted)}.cx-pad{padding:19px}.cx-row{display:flex;justify-content:space-between;gap:14px;align-items:center;padding:15px 19px;border-bottom:1px solid #e7e5db}.cx-row:last-child{border:0}.cx-row strong{font-size:13px}.cx-row small{display:block;color:var(--cx-muted);font-size:12px;line-height:1.6}.cx-row .cx-link{flex:1;min-width:0;text-decoration:none}.cx-attention{margin-top:3px}.cx-tabs{display:flex;gap:18px;overflow:auto;border-bottom:1px solid var(--cx-line);margin-bottom:18px}.cx-tabs button{white-space:nowrap;border:0;border-bottom:3px solid transparent;background:transparent;min-height:48px;color:#50645a;cursor:pointer;padding:8px 3px;font:600 13px Inter,system-ui,sans-serif}.cx-tabs button[aria-current]{border-color:#29463d;color:#182c29}\n.cx-dialog{position:fixed;inset:0 0 0 auto;margin:0;border:0;border-left:1px solid var(--cx-line);width:min(690px,100vw);max-width:100vw;height:100dvh;max-height:100dvh;padding:0;background:#faf8f2;color:#20332e;box-shadow:-12px 0 55px #182c2928;overflow:hidden}.cx-dialog::backdrop{background:#182c2960}.cx-detail-frame{height:100%;display:flex;flex-direction:column}.cx-detail-head{padding:20px 24px;border-bottom:1px solid var(--cx-line);background:var(--cx-paper);display:flex;justify-content:space-between;gap:16px}.cx-detail-head h2{font-size:23px;line-height:1.3;margin:8px 0;letter-spacing:-.5px}.cx-detail-body{padding:22px 24px;overflow:auto;flex:1;overscroll-behavior:contain}.cx-detail-foot{padding:12px 24px;border-top:1px solid var(--cx-line);background:var(--cx-paper);display:flex;gap:8px;flex-wrap:wrap}.cx-detail-body h3{font-size:14px;margin:0 0 12px}.cx-detail-body label{display:block;font-size:13px;font-weight:600;line-height:1.6;margin:12px 0}.cx-detail-body input:not([type=checkbox]),.cx-detail-body textarea,.cx-detail-body select{display:block;width:100%;font:inherit;color:#20332e;background:white;border:1px solid #9cac9e;border-radius:8px;padding:11px;min-height:44px;margin-top:5px}.cx-detail-body textarea{min-height:90px;resize:vertical}.cx-detail-body input[type=checkbox]{width:20px;height:20px;vertical-align:middle;margin-right:10px}.cx-check{min-height:44px;display:flex!important;align-items:center}.cx-notice{background:#e9eee4;padding:14px;border-radius:9px;font-size:13px;line-height:1.6;margin:12px 0}.cx-error{background:#fae9e5;color:#84352e}.cx-meta{display:grid;grid-template-columns:1fr 1fr;gap:14px;font-size:13px;margin:0}.cx-meta dt{color:var(--cx-muted);font-size:11px;margin-bottom:4px}.cx-meta dd{margin:0;font-weight:600}.cx-history{border-left:3px solid #b8c4b9;padding:0 0 0 14px;margin:18px 0;font-size:13px;line-height:1.7}.cx-history p{margin:6px 0}.cx-inventory{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.cx-inventory .cx-btn{text-align:left}.cx-review-title{max-width:600px}.cx-nav-group summary{color:#d2dbcf;font-size:11px;padding:14px 10px;cursor:pointer}.cx-nav-group .nav-btn{width:100%}\nbutton:focus-visible,a:focus-visible,summary:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #245c49;outline-offset:3px}.sidebar button:focus-visible,.sidebar summary:focus-visible{outline-color:#e7c680}.cx-dialog :focus-visible{scroll-margin:16px}.cx-dialog button{flex-shrink:0}\n@media(min-width:768px){.mobile-nav{display:none!important}.sidebar{display:flex!important}.main{min-width:0}}\n@media(max-width:1050px){.cx-stats{grid-template-columns:repeat(3,minmax(0,1fr))}.cx-grid{grid-template-columns:1fr}.cx-heading h1{font-size:27px}}\n@media(max-width:767px){.sidebar{display:none!important}.main{margin-left:0!important;padding-left:14px!important;padding-right:14px!important;width:100%!important}.mobile-nav{display:flex!important;grid-template-columns:repeat(5,1fr);height:68px;z-index:50}.mobile-nav button{flex:1;min-width:0;min-height:48px;font-size:10px}.cx-harness{padding:8px 14px;font-size:11px}.cx-harness>span{display:none}.cx-harness details{margin-left:0}.cx-heading{flex-wrap:wrap;margin-bottom:18px}.cx-heading h1{font-size:27px}.cx-page{padding-top:16px;padding-bottom:90px}.cx-stats{grid-template-columns:1fr;gap:8px}.cx-stat{min-height:70px;display:grid;grid-template-columns:1fr auto;gap:4px 12px;padding:13px 15px}.cx-stat strong{grid-column:2;grid-row:1/3;font-size:28px;align-self:center}.cx-stat small{grid-column:1}.cx-row{padding:14px;gap:8px;flex-wrap:wrap}.cx-row .cx-link{min-width:150px}.cx-detail-head{padding:16px}.cx-detail-body{padding:18px 16px}.cx-detail-foot{padding:12px 16px calc(12px + env(safe-area-inset-bottom))}.cx-detail-head h2{font-size:21px}.cx-inventory{grid-template-columns:1fr}.cx-card>header{padding:15px}.cx-meta{grid-template-columns:1fr 1fr}.cx-dialog input,.cx-dialog textarea,.cx-dialog select{font-size:16px!important}.topbar{height:auto!important;min-height:60px;flex-wrap:wrap}.top-actions{flex-wrap:wrap}.demo-chip{display:none!important}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\n"]],"\n",["BODY",{"class":"owner-dashboard-mode"},["A",{"class":"cx-skip","href":"#connected-surface"},"Skip to work content"],"\n",["ASIDE",{"class":"cx-harness","aria-label":"Prototype review controls"},["STRONG",{},"UX REVIEW · P1 + P2a"],["SPAN",{},"Synthetic data · no bac